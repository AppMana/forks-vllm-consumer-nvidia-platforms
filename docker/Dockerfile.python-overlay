ARG BASE_IMAGE=ghcr.io/appmana/vllm-consumer:sm86-sm121-2cb0042e1d-arm64@sha256:defd0bc7005ad1d91fb74e8e5aef47656fc09960e3478421139511e45162e325
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG VLLM_BUILD_COMMIT
ARG VLLM_IMAGE_TAG

COPY vllm/v1/core/kv_cache_utils.py /tmp/vllm-overlay/v1/core/kv_cache_utils.py
COPY vllm/v1/kv_cache_interface.py /tmp/vllm-overlay/v1/kv_cache_interface.py
COPY vllm/v1/worker/gpu/warmup.py /tmp/vllm-overlay/v1/worker/gpu/warmup.py
COPY vllm/model_executor/warmup/kernel_warmup.py /tmp/vllm-overlay/model_executor/warmup/kernel_warmup.py
COPY vllm/model_executor/warmup/qwen_triton_warmup.py /tmp/vllm-overlay/model_executor/warmup/qwen_triton_warmup.py
COPY vllm/model_executor/layers/fused_moe/experts/sparkinfer_moe.py /tmp/vllm-overlay/model_executor/layers/fused_moe/experts/sparkinfer_moe.py
COPY vllm/model_executor/layers/fused_moe/oracle/nvfp4.py /tmp/vllm-overlay/model_executor/layers/fused_moe/oracle/nvfp4.py
COPY vllm/model_executor/layers/quantization/dsv4_int.py /tmp/vllm-overlay/model_executor/layers/quantization/dsv4_int.py
COPY vllm/model_executor/layers/quantization/utils/flashinfer_fp4_moe.py /tmp/vllm-overlay/model_executor/layers/quantization/utils/flashinfer_fp4_moe.py
COPY vllm/model_executor/model_loader/default_loader.py /tmp/vllm-overlay/model_executor/model_loader/default_loader.py
COPY vllm/model_executor/model_loader/flashpack_loader.py /tmp/vllm-overlay/model_executor/model_loader/flashpack_loader.py
COPY vllm/model_executor/model_loader/pp_weight_filter.py /tmp/vllm-overlay/model_executor/model_loader/pp_weight_filter.py
COPY vllm/model_executor/model_loader/weight_utils.py /tmp/vllm-overlay/model_executor/model_loader/weight_utils.py
COPY vllm/models/deepseek_v4/common/ops/cache_utils.py /tmp/vllm-overlay/models/deepseek_v4/common/ops/cache_utils.py
COPY vllm/transformers_utils/configs/dsv4/kernel_config.py /tmp/vllm-overlay/transformers_utils/configs/dsv4/kernel_config.py

RUN python3 - <<'PY'
import importlib.util
import pathlib
import shutil

spec = importlib.util.find_spec("vllm")
assert spec is not None and spec.submodule_search_locations
root = pathlib.Path(next(iter(spec.submodule_search_locations)))
sources = pathlib.Path("/tmp/vllm-overlay")
for relative in (
    "v1/core/kv_cache_utils.py",
    "v1/kv_cache_interface.py",
    "v1/worker/gpu/warmup.py",
    "model_executor/warmup/kernel_warmup.py",
    "model_executor/warmup/qwen_triton_warmup.py",
    "model_executor/layers/fused_moe/experts/sparkinfer_moe.py",
    "model_executor/layers/fused_moe/oracle/nvfp4.py",
    "model_executor/layers/quantization/dsv4_int.py",
    "model_executor/layers/quantization/utils/flashinfer_fp4_moe.py",
    "model_executor/model_loader/default_loader.py",
    "model_executor/model_loader/flashpack_loader.py",
    "model_executor/model_loader/pp_weight_filter.py",
    "model_executor/model_loader/weight_utils.py",
    "models/deepseek_v4/common/ops/cache_utils.py",
    "transformers_utils/configs/dsv4/kernel_config.py",
):
    destination = root / relative
    shutil.copy2(sources / relative, destination)

promote = (root / "v1/core/kv_cache_utils.py").read_text()
merge = (root / "v1/kv_cache_interface.py").read_text()
assert "kv_quant_mode=spec.kv_quant_mode" in promote
assert "indexes_kv_by_block_stride=spec.indexes_kv_by_block_stride" in promote
assert "kv_quant_mode=specs[0].kv_quant_mode" in merge
assert "alignment=specs[0].alignment" in merge
gpu_warmup = (root / "v1/worker/gpu/warmup.py").read_text()
kernel_warmup = (root / "model_executor/warmup/kernel_warmup.py").read_text()
qwen_warmup = (root / "model_executor/warmup/qwen_triton_warmup.py").read_text()
dsv4_int = (root / "model_executor/layers/quantization/dsv4_int.py").read_text()
sparkinfer_moe = (
    root / "model_executor/layers/fused_moe/experts/sparkinfer_moe.py"
).read_text()
nvfp4_oracle = (
    root / "model_executor/layers/fused_moe/oracle/nvfp4.py"
).read_text()
flashinfer_fp4 = (
    root / "model_executor/layers/quantization/utils/flashinfer_fp4_moe.py"
).read_text()
pp_filter = (root / "model_executor/model_loader/pp_weight_filter.py").read_text()
cache_utils = (root / "models/deepseek_v4/common/ops/cache_utils.py").read_text()
kernel_config = (
    root / "transformers_utils/configs/dsv4/kernel_config.py"
).read_text()
assert "prompt_len = min(256" in gpu_warmup
assert "zero_kv_blocks_warmup(worker.model_runner)" in kernel_warmup
assert "def zero_kv_blocks_warmup" in qwen_warmup
assert "VLLM_DSV4_ALLSPARK_SM12X_CUBLAS_M_THRESHOLD" in dsv4_int
assert "input_scales_static=True" in sparkinfer_moe
assert "require_uniform_nvfp4_expert_scale" in nvfp4_oracle
assert "merge_nvfp4_gate_up_input_scales" in flashinfer_fp4
assert "def should_skip_pp_weight" in pp_filter
assert "def classify_shards" in pp_filter
assert "INT8_DS_MLA_ENTRY_BYTES" in cache_utils
assert "has_int_weight_family" in kernel_config
shutil.rmtree("/tmp/vllm-overlay")
print("packed DSV4 KV-cache geometry and prefill warmup fixes installed")
PY

ENV VLLM_BUILD_COMMIT=${VLLM_BUILD_COMMIT} \
    VLLM_IMAGE_TAG=${VLLM_IMAGE_TAG}
LABEL org.opencontainers.image.revision="${VLLM_BUILD_COMMIT}" \
      org.opencontainers.image.version="${VLLM_IMAGE_TAG}" \
      ai.vllm.build.commit="${VLLM_BUILD_COMMIT}" \
      ai.vllm.image.tag="${VLLM_IMAGE_TAG}" \
      ai.appmana.overlay.base="${BASE_IMAGE}"
