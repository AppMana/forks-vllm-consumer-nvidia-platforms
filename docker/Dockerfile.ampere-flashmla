# FlashMLA-Ampere overlay: keeps the known-good native flash_mla wheel already
# baked into the vLLM image and overlays the Python int8 sparse MLA exports used
# by the sm86 int8_ds_mla Triton path.
#
#   docker build -f docker/Dockerfile.ampere-flashmla \
#     --build-arg BASE_IMAGE=harbor.appmana.com/appmana/vllm-ampere:<tag> \
#     -t harbor.appmana.com/appmana/vllm-ampere:<tag>-flashmla <flash-mla-source-context>

ARG BASE_IMAGE=harbor.appmana.com/appmana/vllm-ampere:latest
FROM ${BASE_IMAGE}

ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/torch/lib:${LD_LIBRARY_PATH}

COPY flash_mla/int8_sparse_mla.py /tmp/flashmla/int8_sparse_mla.py
RUN python3 - <<'PY'
import pathlib
import shutil

import flash_mla

pkg = pathlib.Path(flash_mla.__file__).parent
shutil.copyfile("/tmp/flashmla/int8_sparse_mla.py", pkg / "int8_sparse_mla.py")
init_path = pkg / "__init__.py"
init_text = init_path.read_text()
export_line = (
    "from .int8_sparse_mla import (quantize_int8_ds_mla_rows, "
    "sparse_int8_mla_decode, sparse_int8_mla_prefill_native_staged)\n"
)
if "sparse_int8_mla_decode" not in init_text:
    init_path.write_text(init_text.rstrip() + "\n" + export_line)
shutil.rmtree("/tmp/flashmla")
PY
RUN python3 -c "import torch, flash_mla, flash_mla_cuda; assert hasattr(torch.ops.flash_mla, 'fwd_kvcache_mla'); assert hasattr(flash_mla, 'sparse_int8_mla_decode'); print('flash_mla int8 python overlay OK')"
